{
    "name": "kinetis/queue-sqs",
    "description": "A Fiber-native non-blocking Amazon SQS backend for kinetis/queue's QueueInterface.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.19.1",
        "kinetis/queue": "^1.5.3",
        "kinetis/revolt-http-client": "^1.1.1",
        "async-aws/sqs": "^2.9"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "kinetis/cache-redis": "^1.0.5",
        "kinetis/persistence": "^1.10.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\QueueSqs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\QueueSqs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
